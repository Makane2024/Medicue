# Copy to .env.local. Leave VITE_API_URL empty to run against the built-in mock API.
# Value: the `ApiUrl` output printed by `cdk deploy` (the MediCueApiStack stage URL, ending in /prod/).
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/prod/

# Show the "simulate a failed payment" link. Set to false once a real payment provider replaces the mock
# (the backend must then be deployed with: cdk deploy -c allowPaymentSimulation=false).
VITE_PAYMENT_SIMULATION=true
